# ShoshChat AI - Production Environment Variables
# Copy this file to .env.production and fill in your values

# Django Settings
DJANGO_SETTINGS_MODULE=core.settings.production
SECRET_KEY=your-super-secret-key-here-change-this-in-production
DEBUG=False
ALLOWED_HOSTS=shoshchat.ai,www.shoshchat.ai,your-domain.com

# Database
POSTGRES_DB=shoshchat_prod
POSTGRES_USER=shoshchat
POSTGRES_PASSWORD=your-secure-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://:your-redis-password@redis:6379/0
REDIS_PASSWORD=your-secure-redis-password

# Celery
CELERY_BROKER_URL=redis://:your-redis-password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:your-redis-password@redis:6379/0

# Email Configuration (for production emails)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@shoshchat.ai

# OpenAI API
OPENAI_API_KEY=sk-your-openai-api-key-here

# Pinecone Vector DB
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-west1-gcp
PINECONE_INDEX_NAME=shoshchat-prod

# AWS S3 (for media files - optional)
USE_S3=False
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=shoshchat-media-prod
AWS_S3_REGION_NAME=us-east-1

# Stripe (for payments)
STRIPE_PUBLIC_KEY=pk_live_your-stripe-public-key
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Sentry (for error tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Security
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# CORS (if frontend is on different domain)
CORS_ALLOWED_ORIGINS=https://shoshchat.ai,https://www.shoshchat.ai

# Flower Monitoring
FLOWER_USER=admin
FLOWER_PASSWORD=your-secure-flower-password

# Logging
LOG_LEVEL=INFO

# Backup Configuration
BACKUP_ENABLED=True
BACKUP_RETENTION_DAYS=30
