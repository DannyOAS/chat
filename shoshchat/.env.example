# Environment Configuration
DJANGO_ENVIRONMENT=development  # development, staging, or production

# Django Configuration
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True
DJANGO_LOG_LEVEL=INFO
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SESSION_COOKIE_SAMESITE=Lax
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_SECURE_REFERRER_POLICY=strict-origin
DJANGO_CSRF_TRUSTED_ORIGINS=

# Database Configuration
POSTGRES_DB=shoshchat
POSTGRES_USER=shoshchat
POSTGRES_PASSWORD=shoshchat
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# DigitalOcean AI Agent Configuration
AI_PROVIDER=gradient
DO_GRADIENT_API_KEY=your-do-ai-agent-key-here
DO_GRADIENT_ENDPOINT=https://ijszbvtt5xxsbdu2fhgtmiot.agents.do-ai.run

# Stripe Configuration
STRIPE_LIVE_MODE=False
STRIPE_TEST_PUBLIC_KEY=pk_test_your-key-here
STRIPE_TEST_SECRET_KEY=sk_test_your-key-here
STRIPE_LIVE_PUBLIC_KEY=
STRIPE_LIVE_SECRET_KEY=
DJSTRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# DRF Throttle Rates
DRF_THROTTLE_USER=1000/day
DRF_THROTTLE_ANON=100/day
DRF_THROTTLE_AUTH_LOGIN=10/min
DRF_THROTTLE_AUTH_REGISTER=5/hour
DRF_THROTTLE_AUTH_RESET=5/hour
DRF_THROTTLE_AUTH_VERIFY=5/hour
DRF_THROTTLE_CHAT=120/min

# Email Configuration
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=support@shoshchat.ai

# Optional: Production Email (uncomment and configure for production)
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-sendgrid-api-key

# Sentry Configuration (for error tracking in staging/production)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
GIT_COMMIT_SHA=

# Site Configuration
SITE_NAME=ShoshChat
SITE_URL=https://shoshchat.ai
